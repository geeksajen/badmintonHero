# 複製成 .env.local 使用（.env.local 不進版控）

# 'local'（預設，開發用，存在瀏覽器 localStorage）或 'firebase'（正式，跨裝置同步）
# ⚠️ 開發、除錯、跑動畫時一律用 local，避免 hot-reload 反覆重掛監聽消耗 Firestore 額度
VITE_STORE_MODE=local

# players/{VITE_PLAYER_ID}。新增第二個孩子時換一個 id（spec §12.7）
VITE_PLAYER_ID=hero

# 家長控制台 #/admin 的 4 位數 PIN（僅防小孩誤入，不是資安措施）
VITE_ADMIN_PIN=0000

# Firebase Console → 專案設定 → 一般 → 你的應用程式（Web）
# apiKey 本來就是公開值，安全性完全依賴 firestore.rules
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
